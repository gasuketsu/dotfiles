#! /usr/bin/env bash

if ! command -v nix >/dev/null 2>&1; then
    args=("--no-confirm true")

{{ if eq .chezmoi.os "linux" }}
{{   if contains .chezmoi.osRelease.id "suse" }}
    if ! grep -q "ssl-cert-file" /etc/nix/nix.custom.conf 2>/dev/null; then
        args+=("--ssl-cert-file /etc/ssl/ca-bundle.pem")
    fi
{{   end }}
{{ end }}
    curl -fsSL https://install.determinate.systems/nix | sh -s -- install ${args[@]}
fi
